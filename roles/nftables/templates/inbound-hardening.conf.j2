# Established/related first
ct state established,related accept

# Drop invalid
ct state invalid drop

# Loopback
iif lo accept

# ICMP (rate-limited)
ip protocol icmp limit rate 50/second accept
ip6 nexthdr ipv6-icmp limit rate 50/second accept

# SSH with rate limiting (new connections only)
tcp dport {{ ssh_port }} ct state new limit rate 10/minute accept

# Web
tcp dport {80, 443} accept

